# 统一换行符：仓库内一律存 LF，检出时按平台自动转换
# 避免「同一文件在不同机器上产生全量 diff」的问题
* text=auto eol=lf

# 明确文本类型
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.xml    text eol=lf
*.txt    text eol=lf
_headers text eol=lf

# Windows 专用脚本保留 CRLF（如需）
*.bat    text eol=crlf
*.cmd    text eol=crlf

# 二进制文件不做转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.mp4    binary
*.zip    binary
*.exe    binary
